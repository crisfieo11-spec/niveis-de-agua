from colorama import init, Fore, Style

# Inicializa o Colorama
init()

# Função para definir a cor e a mensagem
def verificar_nivel(nivel):
    if nivel == 1:
        return Fore.RED, "Nível 1 - Muito baixo (crítico)"
    elif nivel == 2:
        return Fore.YELLOW, "Nível 2 - Baixo"
    elif nivel == 3:
        return Fore.GREEN, "Nível 3 - Médio"
    elif nivel == 4:
        return Fore.CYAN, "Nível 4 - Alto"
    elif nivel == 5:
        return Fore.BLUE, "Nível 5 - Muito alto (alerta)"
    else:
        return None, "Nível inválido! Digite um número de 1 a 5."

# Solicita o nível ao usuário
nivel = int(input("Digite o nível do reservatório (1 a 5): "))

# Obtém a cor e a mensagem
cor, mensagem = verificar_nivel(nivel)

# Exibe o resultado
if cor:
    print(cor + mensagem)
else:
    print(mensagem)

# Restaura a cor padrão do terminal
print(Style.RESET_ALL)